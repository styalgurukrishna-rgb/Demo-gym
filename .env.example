# KSG DEMO GYM / Production Environment Configuration
# Copy this file to .env or set variables in your cloud deployment platform

# Node & App Environment
NODE_ENV=production
PORT=3000
VITE_APP_ENV=production
VITE_APP_URL=https://www.ksgdemogym.com

# Timezone Configuration (e.g. Asia/Kolkata, America/New_York, Europe/London)
VITE_DEFAULT_TIMEZONE=Asia/Kolkata

# Analytics (Google Analytics 4 / Tag Manager)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps API (Optional for interactive dynamic map features)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXX

# Payment Gateway Configuration (e.g. Razorpay / Stripe / PayU)
VITE_PAYMENT_GATEWAY_KEY=rzp_live_XXXXXXXXXX
PAYMENT_GATEWAY_SECRET=sec_live_XXXXXXXXXX
PAYMENT_WEBHOOK_SECRET=whsec_XXXXXXXXXX

# Server-Side AI / Gemini API
GEMINI_API_KEY=
